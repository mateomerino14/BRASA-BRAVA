NODE_ENV=development
PORT=3000

# Postgres local o en la nube (en escritorio lo define Electron automáticamente)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/brasa_brava

# Obligatorio en producción: texto largo y aleatorio
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Orígenes permitidos para el frontend web (separados por coma)
CORS_ORIGINS=http://localhost:5173

# console = muestra el código en la terminal (desarrollo) | brevo = envía correos reales
MAIL_DRIVER=console
BREVO_API_KEY=
MAIL_FROM_EMAIL=no-reply@brasabrava.bo
MAIL_FROM_NAME=Brasa Brava

RESET_CODE_TTL_MINUTES=10
RESET_CODE_MAX_ATTEMPTS=5
RATE_LIMIT_ENABLED=true

# Carpeta con el build del frontend para servirlo desde la API (opcional)
STATIC_DIR=
